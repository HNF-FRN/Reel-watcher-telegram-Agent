# Copy this file to .env (setup.ps1 does it for you) and fill in your key.
# Free key: https://aistudio.google.com/apikey  ->  Create API key
# Without a key the bot still works; it uses the local backup watcher for every reel.
GEMINI_API_KEY=

# Optional: pin a Gemini model (default tries gemini-3.8-flash, then 3.7 and 3.5 Flash)
# REEL_GEMINI_MODEL=gemini-3.8-flash
