# Copy this file to .env and fill in what you use. Everything is optional except the bot token for reelbot.py.
# One KEY=value per line; comments go on their own lines.

# --- The bot without Claude Code (python reelbot.py) ---
# From @BotFather in Telegram: /newbot. (The Claude Code bot keeps its token in ~/.claude/channels/telegram/.env.)
# TELEGRAM_BOT_TOKEN=

# --- A local model: summaries, and plans and builds with "local" ---
# Any OpenAI-compatible server. Default: Ollama on this computer.
# REEL_LLM_URL=http://localhost:11434/v1
# Unset, the server's models are used as they fit: a vision model (qwen2.5vl, gemma3...) for summaries, and one
# without vision for builds, which has to call tools (qwen3:8b works well). Name one to always use it.
# REEL_LLM_MODEL=qwen3:8b
# Only if the server wants an API key:
# REEL_LLM_KEY=
# Send frames to the model as images: on or off (default: guessed from the model name)
# REEL_LLM_VISION=on
# Never use a model (breakdowns are then a timeline of what was shown and said):
# REEL_LLM=off

# --- Reading the screen and hearing the video (pip install -r requirements-open.txt) ---
# OCR: rapidocr, tesseract or off (default: whichever is installed)
# REEL_OCR=rapidocr
# Tesseract languages, e.g. eng+fra
# REEL_OCR_LANG=eng
# faster-whisper model: tiny, base, small, medium, large-v3
# REEL_WHISPER_MODEL=small

# --- Optional: Gemini watches the whole video with sound instead ---
# Free key: https://aistudio.google.com/apikey  ->  Create API key
# Without a key the open engine watches every reel on this computer.
GEMINI_API_KEY=

# Optional: pin a Gemini model (default tries gemini-3.8-flash, then 3.7 and 3.5 Flash)
# REEL_GEMINI_MODEL=gemini-3.8-flash

# --- Optional: /deeper checks repos on GitHub; a token (no scopes needed) raises the rate limit ---
# GITHUB_TOKEN=
