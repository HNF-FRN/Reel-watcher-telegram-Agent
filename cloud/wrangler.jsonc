// Template. Deploy with your own copy: cp wrangler.jsonc wrangler.local.jsonc (git-ignored), fill in the
// database_id and PUBLIC_URL, then `npm run deploy`. Secrets are set with `npx wrangler secret put` (README.md).
{
  "name": "reel-agent-telegram",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  // No extra public preview addresses for each upload.
  "preview_urls": false,
  // Keep variables set in the Cloudflare dashboard when deploying from here.
  "keep_vars": true,
  "vars": {
    // Your Worker's own address, e.g. https://reel-agent-telegram.<your-subdomain>.workers.dev
    "PUBLIC_URL": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "reel-agent-cloud",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID"
    }
  ],
  // Every minute: failover watchdog, reminders, Gemini watching, routine hand-off.
  "triggers": { "crons": ["* * * * *"] }
}
